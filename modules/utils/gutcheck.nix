{ pkgs
, lib
, ...
}:
let
  version = "0.5.0";

  # ONNX Runtime from nixpkgs, not from the `ort` crate. ort's default
  # `download-binaries` feature fetches a prebuilt ONNX Runtime from pyke's CDN
  # inside build.rs, which no sandboxed build can do; `ORT_LIB_LOCATION` makes
  # ort-sys skip that path entirely and link what we point it at.
  onnxruntime = pkgs.onnxruntime;

  gutcheck = pkgs.rustPlatform.buildRustPackage {
    pname = "gutcheck";
    inherit version;

    src = pkgs.fetchFromGitHub {
      owner = "sfmqrb";
      repo = "gutcheck";
      rev = "v${version}";
      hash = "sha256-OMXHtRJTTp6wZPVUSGDnRL/JRuhhZgvzdgU6rGeFWaw=";
    };

    # Refresh with `nix-build` and the hash from the mismatch error after a
    # version bump, or `nix-prefetch-url --unpack` + `nix hash convert` for src.
    cargoHash = "sha256-JmjBfeaPs4NPh1XqRAe+SxhBSztCRKFD2ViRZsIl5I8=";

    # ort's default feature set asks ONNX Runtime for C API version 27 (`api-27`),
    # and `OrtApiBase::GetApi` returns NULL for anything the runtime does not
    # know - nixpkgs ships 1.24.4, which tops out at 24 ("The requested API
    # version [27] is not available, only API versions [1, 24] are supported in
    # this build"). ort does not probe downwards, so the default build would
    # link fine and then die with "Failed to initialize ORT API" on the first
    # session. Capping the request at `api-24` is the whole fix: the OrtApi
    # struct is append-only, so a lower request is a subset, and gutcheck only
    # ever builds a CPU session and runs it.
    #
    # Dropping the other defaults is deliberate too: `download-binaries` is the
    # CDN fetch above, `tls-native` drags in openssl for that download only, and
    # `copy-dylibs` is for Windows. `ndarray` is unused - gutcheck feeds ort
    # plain `Tensor`s. When bumping ort, re-check the cap against
    # `onnxruntime.version`: it must be <= that minor.
    postPatch = ''
      substituteInPlace Cargo.toml \
        --replace-fail 'ort = "=2.0.0-rc.13"' \
          'ort = { version = "=2.0.0-rc.13", default-features = false, features = [ "std", "api-24" ] }'
    '';

    # Static linking is ort-sys' default when given a lib directory, and nixpkgs
    # builds ONNX Runtime shared-only (no libonnxruntime_common.a and friends),
    # so ask for the dynamic path. The `-L` it emits is a store path, which the
    # nixpkgs ld wrapper turns into an RPATH entry - nothing to wrap afterwards.
    ORT_LIB_LOCATION = "${onnxruntime}/lib";
    ORT_PREFER_DYNAMIC_LINK = "1";

    nativeBuildInputs = [ pkgs.installShellFiles ];

    # clap_complete and clap_mangen are already dependencies; the binary just
    # prints both on demand. Generated by running it here rather than shipped,
    # so the completions can never drift from the flags.
    postInstall = ''
      installShellCompletion --cmd gutcheck \
        --bash <($out/bin/gutcheck --completions bash) \
        --fish <($out/bin/gutcheck --completions fish) \
        --zsh <($out/bin/gutcheck --completions zsh)

      $out/bin/gutcheck --man > gutcheck.1
      installManPage gutcheck.1
    '';

    meta = {
      description = "grep for meaning: filter, score or classify text with a plain-English question, locally on CPU";
      homepage = "https://github.com/sfmqrb/gutcheck";
      license = lib.licenses.mit;
      mainProgram = "gutcheck";
      # Darwin only in theory: the macOS build takes ort with the `coreml`
      # feature (and `--gpu` says as much), which this derivation's feature
      # patch would have to grow before it could be built there.
      platforms = lib.platforms.linux;
    };
  };
in
{
  # The first run downloads the Laya checkpoint (~1.3 GB for `-M multilingual`,
  # less for `english`/`typed`) from Hugging Face into
  # $XDG_CACHE_HOME/gutcheck/<revision>. That stays imperative cache state on
  # purpose: it is per-variant, regenerable, and far too big to pin into the
  # store for a tool that may only ever use one of the three.
  home.packages = [ gutcheck ];
}
